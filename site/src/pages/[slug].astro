---
import Base from '../layouts/Base.astro';
import CasePage from '../components/CasePage.astro';
import { cases } from '../data/cases';

export function getStaticPaths() {
  return cases.map((c) => ({ params: { slug: c.slug }, props: { c } }));
}
const { c } = Astro.props;
---
<Base title={`${c.title} - case study - Konstantin Darovskiy`} description={c.lead}>
  <CasePage c={c} lang="en" />

  <script>
    import { initWorkFrames, initFullViewLinks } from '../scripts/workframe';
    import { initMotion } from '../scripts/motion';
    import { initReveals, initPageWipe, initFrameEntrance, initRailArt } from '../scripts/reveal';
    initMotion();
    initWorkFrames();
    initFullViewLinks();
    initReveals();
    initFrameEntrance();
    initRailArt();
    initPageWipe();
  </script>
</Base>
