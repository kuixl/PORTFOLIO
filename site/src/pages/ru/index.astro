---
import Base from '../../layouts/Base.astro';
import Home from '../../components/Home.astro';
---
<Base
  title="Константин Даровский - веб-дизайнер"
  description="Константин Даровский, веб-дизайнер из Москвы. UX/UI, веб и 3D. Сначала проектирую, потом собираю."
  lang="ru"
  preload
>
  <div id="preloader" aria-hidden="true">
    <canvas id="ascii-canvas"></canvas>
    <svg class="sketches" id="sketch-layer"></svg>
    <span id="preload-wordmark">kuixl</span>
    <div id="preload-invite">
      <span class="invite-key">НАЖМИ ЛЮБУЮ КЛАВИШУ</span>
      <span class="invite-note">клик, скролл или клавиша, чтобы начать со звуком</span>
    </div>
    <button id="sound-toggle" type="button">SOUND OFF</button>
  </div>

  <Home lang="ru" />

  <script>
    import { initPreloader } from '../../scripts/preloader';
    import { initMotion } from '../../scripts/motion';
    import { initFullViewLinks } from '../../scripts/workframe';
    import { initReveals, initAssembleHeading, initIndexHover } from '../../scripts/reveal';
    initPreloader().then(() => {
      initMotion();
      initFullViewLinks();
      initReveals();
      initAssembleHeading();
      initIndexHover();
    });
  </script>
</Base>
