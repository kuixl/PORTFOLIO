---
import '../styles/global.css';
interface Props {
  title: string;
  description?: string;
  /**
   * Only the home page runs the preloader. The lock class has to be scoped to
   * it: nothing else removes `is-preloading`, so on a case page it would leave
   * `overflow: hidden` on <html> for the life of the visit.
   */
  preload?: boolean;
  /** social card image, relative to the site root */
  image?: string;
}
const {
  title,
  description = 'Konstantin Darovskiy, web designer in Moscow. UX/UI, web and 3D. I design the work, then I build it.',
  preload = false,
  image = '/og.png',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://kuixl.github.io');
const ogImage = new URL(image, Astro.site ?? 'https://kuixl.github.io');
---
<!doctype html>
<html lang="en" class={preload ? 'is-preloading' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={ogImage.href} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preload" href="/fonts/switzer-var-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/sligoil-micro-latin.woff2" as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
  </head>
  <body class="bg-paper text-primary">
    <!-- keyboard users should not have to tab through the header on every page -->
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
  </body>
</html>
