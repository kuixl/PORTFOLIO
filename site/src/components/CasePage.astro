---
/**
 * A case page in whichever language it is handed. Structure, frames, screens
 * and section order come from the English record; the Russian file supplies
 * words only, and anything it is missing falls back to English rather than
 * rendering a blank section.
 */
import CaseSection from './CaseSection.astro';
import WorkFrame from './WorkFrame.astro';
import { orderedCases, type Case } from '../data/cases';
import { casesRu } from '../data/cases.ru';
import { caseLabels } from '../data/caseLabels';
import { ui } from '../data/ui';
import { pageName } from '../data/pageNames';
import type { Lang } from '../data/home';
import works from '../data/works.json';

interface Props { c: Case; lang: Lang }
const { c: base, lang } = Astro.props;

const L = caseLabels[lang];
const T = ui[lang];
const c: Case = lang === 'ru' ? { ...base, ...(casesRu[base.slug] ?? {}) } : base;
const pfx = lang === "ru" ? "/ru" : "";
const project = base.frame?.project ?? base.slug;

const shotsFor = (p: string) => (works as Record<string, any[]>)[p] ?? [];

/* Captions come from the page-name table rather than the case record, so the
   tabs above the frame and the captions under the grid always agree. */
const screens = (base.screens ?? [])
  .map(([, page]) => {
    const shot = shotsFor(project).find((s) => s.page === page && s.size === 'desktop');
    if (!shot?.thumb) return null;
    /* Colour, like the index. The reviewer is here to look at the work. */
    const c = shot.thumb.colour as { file: string; w: number; h: number }[] | undefined;
    const base2 = c?.[1] ?? c?.[0] ?? shot.thumb;
    return {
      label: pageName(lang, project, page),
      file: base2.file,
      srcset: c?.map((v: any) => `/works/${project}/${v.file} ${v.w}w`).join(', '),
      w: base2.w,
      h: base2.h,
      full: shot.parts[0].file,
    };
  })
  .filter(Boolean) as { label: string; srcset?: string; file: string; w: number; h: number; full: string }[];

/* The lead screen runs full width and the rest sit under it. A uniform grid of
   equal thumbnails read as a slideshow: nothing told you where to look first. */
const [leadScreen, ...restScreens] = screens;

/**
 * Both neighbours, read off the order of the case list.
 *
 * There used to be a single forward link built from a `next` field written by
 * hand on each case, which meant the chain could only be walked one way: to
 * see the previous work you had to go back to the index and start again. The
 * order now comes from the array itself, so adding a case cannot break the
 * ring and nobody has to remember to update two records.
 *
 * The ring closes rather than repeating. From the last case forward you land
 * on the first, and the card says so.
 */
const ring = orderedCases;
const at = ring.findIndex((c) => c.slug === base.slug);
const neighbour = (step: number) => {
  const c = ring[(at + step + ring.length) % ring.length];
  if (!c || c.slug === base.slug) return undefined;
  const project = c.frame?.project ?? c.slug;
  const shot = shotsFor(project).find((s) => s.size === 'desktop' && s.thumb);
  return {
    slug: c.slug,
    title: c.title,
    teaser: (lang === 'ru' ? casesRu[c.slug]?.teaser : undefined) ?? c.teaser,
    project,
    shot: shot?.thumb ? (shot.thumb.colour?.[1] ?? shot.thumb.colour?.[0] ?? shot.thumb) : undefined,
  };
};
const prevCase = neighbour(-1);
const nextCase = neighbour(1);
/* wrapping forward past the end is the one move worth labelling */
const nextWraps = at === ring.length - 1;
---
{/*
  The language switch belongs on every page, not just the home page.

  Case pages had no switcher at all, so a reader who arrived on a Russian case
  from a link had no way to reach the English one short of going back to the
  index and starting again. It also has to keep them where they are: the pair
  points at this same case in the other language, not at the other home page.
*/}
<header class="site-head">
  <div class="head-inner">
    <a href={pfx || "/"} class="font-mono text-mono-nav">kuixl</a>
    <nav class="head-nav font-mono text-mono-nav">
      <a href={`/${base.slug}/`} aria-current={lang === 'en' ? 'page' : undefined} class={lang === 'en' ? 'is-on' : ''}>EN</a>
      <span class="sep" aria-hidden="true">/</span>
      <a href={`/ru/${base.slug}/`} aria-current={lang === 'ru' ? 'page' : undefined} class={lang === 'ru' ? 'is-on' : ''}>RU</a>
      <a href={`${pfx}/#contact`} class="head-contact">{L.contact}</a>
    </nav>
  </div>
</header>
  <main class="case" id="main">
    <section class="case-cover">
      <div class="cc-meta">
        {c.coverMeta.map(([k, v]) => (
          <span><b>{k}</b>&nbsp;&nbsp;{v}</span>
        ))}
      </div>
      <h1 class="cc-title">{c.title}</h1>
      <p class="cc-lead">{c.lead}</p>
    </section>

    <CaseSection title={L.result} wide>
      <dl class="facts">
        {c.facts.map(([k, v]) => (
          <div><dt>{k}</dt><dd>{v}</dd></div>
        ))}
      </dl>
    </CaseSection>

    {c.frame && (
      <CaseSection title={L.work} wide>
        <WorkFrame
          project={base.frame.project}
          title={c.title}
          url={base.frame.url}
          note={base.frame.note?.[lang]}
          tabs={base.frame.tabs}
          lang={lang}
        />
      </CaseSection>
    )}

    <CaseSection title={L.brief}>
      {c.brief.map((p) => <p>{p}</p>)}
      <dl class="meta">
        {c.meta.map(([k, v]) => (
          <div><dt>{k}</dt><dd>{v}</dd></div>
        ))}
      </dl>
    </CaseSection>

    {c.broken && (
      <CaseSection title={L.broken} aside={c.asides?.broken}>
        {c.broken.map((p) => <p>{p}</p>)}
      </CaseSection>
    )}

    {c.myRole && (
      <CaseSection title={L.role} aside={c.asides?.role}>
        {c.myRole.map((p) => <p>{p}</p>)}
      </CaseSection>
    )}

    {c.personas && (
      <CaseSection title={L.research}>
        <div class="personas">
          {c.personas.map(([name, who, quote]) => (
            <figure class="persona">
              <blockquote>{quote}</blockquote>
              <figcaption><strong>{name}</strong><span>{who}</span></figcaption>
            </figure>
          ))}
        </div>
      </CaseSection>
    )}

    <CaseSection title={L.decisions} aside={c.asides?.decisions}>
      <div class="decisions">
        {c.decisions.map((d) => (
          <article class="decision">
            <h3>{d.title}</h3>
            {d.body.map((p) => <p>{p}</p>)}
          </article>
        ))}
      </div>
    </CaseSection>

    {leadScreen && (
      <CaseSection title={L.screens} wide ground>
        {/* No second label here. "Site pages" sat directly under the section
            label in the same mono, same size, same muted tone, so the band
            opened with two headings stacked on top of each other and it was
            not clear which named what. The captions under each screenshot
            already say these are pages of the site. */}
        <figure class="screen screen-lead">
          <button type="button" class="screen-open"
            data-fullview={`/works/${project}/${leadScreen.full}`}
            data-fullview-label={`${c.title}, ${leadScreen.label}`}>
            {/* alt is empty on purpose: the caption right below already names
                the page, and both being read out produced "HOMEOPEN" */}
            <img src={`/works/${project}/${leadScreen.file}`} srcset={leadScreen.srcset}
              sizes="(min-width: 901px) 1140px, 100vw"
              width={leadScreen.w} height={leadScreen.h}
              alt="" loading="lazy" decoding="async" />
            <span class="screen-cue">{T.open}</span>
          </button>
          <figcaption>{leadScreen.label}</figcaption>
        </figure>
        {restScreens.length > 0 && (
          <div class="screens">
            {restScreens.map((s) => (
              <figure class="screen">
                <button type="button" class="screen-open"
                  data-fullview={`/works/${project}/${s.full}`}
                  data-fullview-label={`${c.title}, ${s.label}`}>
                  <img src={`/works/${project}/${s.file}`} srcset={s.srcset}
                    sizes="(min-width: 901px) 360px, 50vw"
                    width={s.w} height={s.h}
                    alt="" loading="lazy" decoding="async" />
                  <span class="screen-cue">{T.open}</span>
                </button>
                <figcaption>{s.label}</figcaption>
              </figure>
            ))}
          </div>
        )}
      </CaseSection>
    )}

    {c.system && (
      <CaseSection title={L.system}>
        {c.system.map((p) => <p>{p}</p>)}
      </CaseSection>
    )}

    {c.judges && (
      <CaseSection title={L.judges} wide ground>
        <div class="judges">
          {/* No wrapping guillemets. A quote that already contains a
              guillemet phrase would have nested them, and the pair the
              nesting calls for is in neither font file. The blockquote and
              the attribution below carry the job instead. */}
          {c.judges.quotes.map((q) => <blockquote>{q}</blockquote>)}
        </div>
        <span class="judges-src font-mono">{c.judges.source}</span>
      </CaseSection>
    )}

    <CaseSection title={L.retro} aside={c.asides?.retro}>
      {c.retro.map((p) => <p>{p}</p>)}
    </CaseSection>

    {/* Both directions, so a reader can walk the portfolio without going back
        to the index between every case. */}
    <nav class="case-nav" aria-label={L.caseNav}>
      {prevCase && (
        <a class="cn-card cn-prev" href={`${pfx}/${prevCase.slug}/`}>
          {prevCase.shot && (
            <span class="cn-shot">
              <img src={`/works/${prevCase.project}/${prevCase.shot.file}`}
                width={prevCase.shot.w} height={prevCase.shot.h}
                alt="" loading="lazy" decoding="async" />
            </span>
          )}
          <span class="cn-text">
            <span class="cn-kicker font-mono">{L.prev}</span>
            <span class="cn-title">{prevCase.title}</span>
            <span class="cn-lead">{prevCase.teaser}</span>
          </span>
        </a>
      )}

      {nextCase && (
        <a class="cn-card cn-next" href={`${pfx}/${nextCase.slug}/`}>
          {nextCase.shot && (
            <span class="cn-shot">
              <img src={`/works/${nextCase.project}/${nextCase.shot.file}`}
                width={nextCase.shot.w} height={nextCase.shot.h}
                alt="" loading="lazy" decoding="async" />
            </span>
          )}
          <span class="cn-text">
            <span class="cn-kicker font-mono">{nextWraps ? L.nextWrap : L.next}</span>
            <span class="cn-title">{nextCase.title}</span>
            <span class="cn-lead">{nextCase.teaser}</span>
          </span>
        </a>
      )}
    </nav>

    <p class="case-all font-mono">
      <a href={pfx || '/'}>{L.allWorks}</a>
      <a href={`${pfx}/#contact`}>{L.write}</a>
    </p>
  </main>

<style>
  /* Same container as the home page, so the wordmark in the bar and the case
     title below it share a left edge. The bar itself is styled in global.css. */
  .case {
    max-width: 1240px;
    margin-inline: auto;
    padding-inline: var(--pad-x);
    padding-bottom: var(--gap-section);
  }

  .case-cover { padding-block: var(--gap-block) var(--gap-section); }
  .cc-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--gap-block);
    font-family: var(--font-mono);
    font-size: var(--text-mono-caption);
    letter-spacing: 0.1em;
    color: var(--color-muted);
  }
  .cc-meta b { font-weight: 400; }
  .cc-title {
    margin-top: var(--gap-item);
    font-family: var(--font-sans);
    font-weight: 900;
    font-size: clamp(56px, 15vw, 180px);
    /* see the note on Cyrillic diacritics in global.css */
    line-height: 1;
    letter-spacing: -0.03em;
  }
  .cc-lead {
    margin-top: var(--gap-item);
    max-width: 640px;
    font-size: var(--text-body-lg);
    color: var(--color-muted);
  }

  .facts { display: grid; gap: var(--gap-block); grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); }

  /* One rule per row is the whole reason the page felt like graph paper. The
     label column already separates key from value, so the rows only need
     space. */
  .meta { margin-top: var(--gap-block); }
  .meta > div {
    display: grid;
    grid-template-columns: 1fr;
    gap: 4px;
    padding-block: var(--gap-tight);
  }
  @media (min-width: 901px) {
    .meta > div { grid-template-columns: 150px minmax(0, 1fr); gap: var(--gap-block); align-items: baseline; }
  }
  .facts dt, .meta dt {
    font-family: var(--font-mono);
    font-size: var(--text-mono-caption);
    letter-spacing: 0.1em;
    color: var(--color-muted);
  }
  .facts dd { margin-top: 6px; font-weight: 700; font-size: 22px; line-height: 1.2; }
  .meta dd { font-size: var(--text-body); }

  .personas { display: grid; gap: var(--gap-block); grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); }
  /* The quote leads and the name signs it, the way a pull quote works on
     paper. Italic is gone: it appeared on personas and jury and nowhere else
     on the site, so it read as a stray default rather than a decision. */
  .persona blockquote {
    font-size: 19px;
    line-height: 1.45;
    text-wrap: pretty;
  }
  .persona figcaption { margin-top: var(--gap-tight); display: flex; flex-wrap: wrap; gap: var(--gap-tight); align-items: baseline; }
  .persona strong { font-size: 15px; font-weight: 700; }
  .persona span {
    font-family: var(--font-mono);
    font-size: var(--text-mono-caption);
    letter-spacing: 0.06em;
    color: var(--color-muted);
  }

  /* Three identical stacks of a bold line and two grey paragraphs read as one
     undifferentiated column. The big numeral that used to sit in a gutter was
     the same trick as the section numbers and had the same problem: it implied
     an order the reasoning does not have. Space and heading weight do the
     separating now. */
  .decisions { display: grid; gap: var(--gap-section); }
  /* No max-width here. CaseSection already caps every paragraph at the one
     measure; capping the article as well stacked two limits and made the
     decisions column 530px against 627px everywhere else on the same page. */
  .decision { }
  .decision h3 {
    max-width: var(--measure);
    font-size: clamp(22px, 2.4vw, 30px);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }
  .decision p { margin-top: var(--gap-item); }
  /* the opening sentence carries the claim; let it lead */
  .decision p:first-of-type { font-size: 19px; line-height: 1.55; color: var(--color-primary); }

  .screen-lead { margin-bottom: var(--gap-block); }
  .screens {
    display: grid;
    gap: var(--gap-item);
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  @media (min-width: 901px) {
    /* A fixed card, not auto-fit. auto-fit divides the row between however
       many cards there are, so nichive's five came out at 349px and
       Yakitoria's two at 548px: the same screenshots at two different sizes
       depending on how many the case happened to have. */
    .screens {
      gap: var(--gap-block);
      grid-template-columns: repeat(auto-fill, 340px);
      justify-content: start;
    }
  }
  .screen-open {
    position: relative;
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }
  /* Same treatment as the index previews: the projects keep their colours and
     the grain puts them back on the site's stock. */
  .screen-open, .cn-shot { position: relative; }
  .screen img { width: 100%; height: auto; display: block; }
  .screen-open::after, .cn-shot::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: var(--preview-grain);
    background-image: var(--grain);
    background-size: 180px 180px;
  }
  .screen-cue {
    position: absolute;
    inset: auto 8px 8px auto;
    padding: 4px 8px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    color: var(--color-paper);
    background: var(--color-ink);
    opacity: 0;
    transition: opacity var(--duration-base) ease;
  }
  .screen-open:hover .screen-cue,
  .screen-open:focus-visible .screen-cue { opacity: 1; }
  .screen figcaption {
    margin-top: var(--gap-tight);
    font-family: var(--font-mono);
    font-size: var(--text-mono-caption);
    letter-spacing: 0.08em;
    color: var(--color-caption);
  }

  .judges { display: grid; gap: var(--gap-block); grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); }
  .judges blockquote {
    font-size: 20px;
    line-height: 1.45;
    text-wrap: pretty;
  }
  /* the attribution belongs to the quotes above it, not to the space below */
  .judges-src {
    display: block;
    margin-top: var(--gap-item);
    font-size: var(--text-mono-caption);
    letter-spacing: 0.1em;
    color: var(--color-caption);
  }

  /* Two cards side by side. Stacked on a phone, where a half-width preview
     would be too small to tell one project from another.
     No top margin: the retro section above already pads its own bottom. */
  .case-nav {
    display: grid;
    gap: var(--gap-block);
    padding-top: var(--gap-block);
    border-top: 1px solid var(--color-hairline);
  }
  .cn-card { display: grid; gap: var(--gap-item); align-content: start; }
  .cn-shot { display: block; overflow: hidden; }
  .cn-shot img {
    display: block;
    width: 100%;
    height: auto;
    transition: transform var(--duration-slow) var(--ease-out);
  }
  .cn-card:hover .cn-shot img { transform: scale(1.02); }
  .cn-card:hover .cn-title { text-decoration: underline; text-underline-offset: 6px; }
  .cn-text { display: flex; flex-direction: column; gap: var(--gap-tight); }
  .cn-kicker {
    font-size: var(--text-mono-caption);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  /* Smaller than the old single card. Two of these at 80px would have shouted
     louder than the case title at the top of the page. */
  .cn-title {
    font-family: var(--font-sans);
    font-weight: 900;
    font-size: clamp(28px, 4.4vw, 44px);
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .cn-lead { max-width: 42ch; color: var(--color-muted); }

  .case-all {
    display: flex;
    flex-wrap: wrap;
    gap: var(--gap-block);
    margin-top: var(--gap-section);
    padding-top: var(--gap-block);
    border-top: 1px solid var(--color-hairline);
  }
  .case-all a {
    font-size: var(--text-mono-caption);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding-bottom: 3px;
    border-bottom: 1px solid var(--color-primary);
  }

  @media (min-width: 901px) {
    .case-nav { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
</style>
