---
/**
 * One numbered section of a case page. The number and title sit in a narrow
 * left rail so the body copy keeps a readable measure instead of stretching
 * across the full grid.
 */
import { readFileSync, readdirSync } from 'node:fs';
import { fileURLToPath } from 'node:url';

interface Props {
  n: string;
  title: string;
  wide?: boolean;
  id?: string;
  /** rail drawing: a per-case offset so two cases do not open on the same one */
  art?: string;
  /** position within the case, so no drawing repeats on a page */
  artIndex?: number;
}
const { n, title, wide = false, id, art, artIndex = 0 } = Astro.props;

/**
 * The rail sits empty for the height of a long section. It gets the artwork
 * itself, cut out and recoloured, rather than a re-conversion of it: a grid
 * narrow enough to fit 240px has too few columns to keep a subject and comes
 * out as scattered dots.
 */
const ART_DIR = fileURLToPath(new URL('../../public/art/', import.meta.url));
let artSrc = '';
if (art) {
  const files = readdirSync(ART_DIR).filter((f) => f.endsWith('.cut.webp')).sort();
  if (files.length) {
    // Hashing the section name alone repeated drawings within a page - with
    // eleven files and five sections a collision is likely, and two identical
    // drawings a screen apart read as a bug. The case name sets a starting
    // point and sections walk forward from it, so a page never repeats.
    let h = 0;
    for (const ch of art) h = (h * 31 + ch.charCodeAt(0)) >>> 0;
    artSrc = `/art/${files[(h + artIndex) % files.length]}`;
  }
}
---
<section class="case-section" id={id} data-wide={wide ? '' : undefined}>
  <div class="cs-rail">
    <span class="cs-n">{n}</span>
    <h2 class="cs-title">{title}</h2>
    {artSrc && (
      <div class="cs-art-box" aria-hidden="true">
        <img class="cs-art" src={artSrc} alt="" loading="lazy" decoding="async" />
      </div>
    )}
  </div>
  <div class="cs-body" data-reveal data-reveal-children>
    <slot />
  </div>
</section>

<style>
  .case-section {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--gap-block);
    /* was 120 top and bottom - a rhythm that reads as unfinished rather than
       generous once the sections carry real content */
    padding-block: var(--gap-section);
    border-top: 1px solid var(--color-hairline);
  }
  .cs-rail { display: flex; align-items: baseline; gap: var(--gap-item); }
  .cs-n {
    font-family: var(--font-mono);
    font-size: var(--text-mono-label);
    color: var(--color-muted);
    padding-right: var(--gap-tight);
    border-right: 1px solid var(--color-hairline);
  }
  /* Case pages are commentary about a product, not the product. Setting their
     headings in the same heavy grotesque as the sites they describe made the
     two read as one continuous thing. Mono, small, ruled - the voice of an
     annotation rather than a title. */
  .cs-title {
    font-family: var(--font-mono);
    font-weight: 400;
    font-size: clamp(15px, 1.6vw, 18px);
    line-height: 1.2;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    hyphens: none;
    overflow-wrap: normal;
  }
  .cs-body > :global(* + *) { margin-top: var(--gap-item); }

  /* Hidden on narrow screens: the rail collapses to a single line there and a
     drawing would push the section it labels off the screen. */
  .cs-art-box { display: none; }
  @media (min-width: 901px) {
    /* The clip has to live on a wrapper. `overflow: hidden` on the scaled
       element itself clips its children, not its own transformed box, so the
       drawing kept running out over the body copy. */
    .cs-art-box {
      display: block;
      width: 100%;
      margin-top: var(--gap-block);
      pointer-events: none;
      user-select: none;
    }
    /* Sized to fit the rail outright rather than scaled and clipped: clipping
       showed one corner of a drawing, which reads as a stray mark, not art.
       At 76 columns a 5.2px monospace advance lands just inside 240px. */
    .cs-art {
      display: block;
      width: 100%;
      max-width: 220px;
      height: auto;
      opacity: 0.62;
    }
  }

  @media (min-width: 901px) {
    .case-section {
      grid-template-columns: 240px minmax(0, 1fr);
      gap: var(--gap-block);
    }
    .cs-rail {
      flex-direction: row;
      align-items: baseline;
      /* the drawing is a third child of a row - without this it lines up beside
         the heading and runs into the body column */
      flex-wrap: wrap;
      gap: var(--gap-tight);
      position: sticky;
      top: var(--gap-item);
      align-self: start;
    }
    .cs-art-box { flex-basis: 100%; }
    .case-section[data-wide] { grid-template-columns: 1fr; }
    .case-section[data-wide] .cs-rail { flex-direction: row; align-items: baseline; }
  }
</style>
