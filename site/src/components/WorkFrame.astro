---
/**
 * Full-page view of a shipped project.
 *
 * Desktop: the frame pins and the page scrolls through it, so the whole site
 * passes by in about two screens of scrolling. Click opens it full screen for
 * anyone who wants to actually read it.
 * Mobile: no pinning - it fights inertial scroll on touch. Static first screen,
 * tap to open, and the mobile capture is used where one exists.
 *
 * Projects carry different amounts of material on purpose: nichive shipped and
 * has six captures, BETA has one page. The component shows what each has rather
 * than flattening everyone down to the thinnest.
 */
import works from '../data/works.json';
import { ui, pageCount } from '../data/ui';
import { pageName } from '../data/pageNames';
import type { Lang } from '../data/home';

interface Props {
  project: keyof typeof works;
  title: string;
  url?: string;
  note?: string;
  /** limit which pages get a tab; the rest stay available for screen grids */
  tabs?: string[];
  lang: Lang;
}
const { project, title, url, note, tabs, lang } = Astro.props;
const T = ui[lang];

const all = works[project] as {
  page: string; size: string; w: number; h: number;
  parts: { file: string; w: number; h: number; kb: number }[];
}[];
const shots = tabs ? all.filter((s) => tabs.includes(s.page)) : all;

// the entry page leads regardless of how the files sort alphabetically -
// otherwise nichive opens on "exhibitions" because e comes before i
const ENTRY = ['index', 'landing', 'menu', 'home'];
const pages = [...new Set(shots.map((s) => s.page))].sort((a, b) => {
  const ai = ENTRY.indexOf(a), bi = ENTRY.indexOf(b);
  if (ai !== bi) return (ai < 0 ? 99 : ai) - (bi < 0 ? 99 : bi);
  return a.localeCompare(b);
});
const hasMobile = shots.some((s) => s.size === 'mobile');
const first = pages[0];
---

<section class="work-frame" data-project={project}>
  <header class="wf-head">
    <span class="wf-label">{T.fullView}</span>

    {pages.length > 1 && (
      <div class="wf-tabs" role="tablist" aria-label={title}>
        {pages.map((p) => (
          <button type="button" role="tab" data-page={p}
            aria-selected={p === first ? 'true' : 'false'}
            class={p === first ? 'is-active' : ''}>{pageName(lang, project, p)}</button>
        ))}
      </div>
    )}

    {hasMobile && (
      <div class="wf-sizes" role="group" aria-label={T.viewport}>
        <button type="button" data-size="desktop" class="is-active">1440</button>
        <button type="button" data-size="mobile">375</button>
      </div>
    )}
  </header>

  <div class="wf-frame" data-frame>
    <div class="wf-chrome">
      <span class="wf-dots"><i></i><i></i><i></i></span>
      <span class="wf-url">{url ?? title.toLowerCase()}</span>
      <span class="wf-hint">{T.clickToOpen}</span>
    </div>
    <div class="wf-viewport" data-viewport>
      {[...shots].sort((a, b) => pages.indexOf(a.page) - pages.indexOf(b.page)).map((s) => (
        <img
          src={`/works/${project}/${s.parts[0].file}`}
          width={s.parts[0].w}
          height={s.parts[0].h}
          alt={`${title}, ${pageName(lang, project, s.page)}`}
          data-page={s.page}
          data-size={s.size}
          class={s.page === first && s.size === 'desktop' ? 'is-active' : ''}
          loading="lazy"
          decoding="async"
        />
      ))}
    </div>
  </div>

  <div class="wf-foot">
    <span class="wf-count">{pageCount(pages.length, lang)}</span>
    {note && <span class="wf-note">{note}</span>}
    {url && <a class="wf-live" href={url} target="_blank" rel="noopener">{T.openLive} &rarr;</a>}
  </div>
</section>

<style>
  .work-frame {
    margin-block: 0 var(--gap-item);
  }

  .wf-head {
    display: flex;
    align-items: baseline;
    gap: var(--gap-block);
    flex-wrap: wrap;
    margin-bottom: var(--gap-item);
  }
  .wf-label {
    font-family: var(--font-mono);
    font-size: var(--text-mono-label);
    letter-spacing: 0.12em;
    color: var(--color-muted);
    margin-right: auto;
  }

  /* The tab strip is as wide as the page names inside it. On a 320px screen
     three of them push the whole window past the edge, so it wraps. */
  .wf-tabs, .wf-sizes { display: flex; flex-wrap: wrap; gap: 2px; }
  .wf-tabs button, .wf-sizes button {
    font-family: var(--font-mono);
    font-size: var(--text-mono-caption);
    letter-spacing: 0.06em;
    padding: 6px 12px;
    color: var(--color-muted);
    border: 1px solid var(--color-hairline);
    background: transparent;
    cursor: pointer;
    transition: color var(--duration-base) ease, border-color var(--duration-base) ease, background var(--duration-base) ease;
  }
  .wf-tabs button:hover, .wf-sizes button:hover { color: var(--color-primary); }
  .wf-tabs button.is-active, .wf-sizes button.is-active {
    color: var(--color-paper);
    background: var(--color-ink);
    border-color: var(--color-ink);
  }

  /* the window itself */
  .wf-frame {
    position: relative;
    border: 1px solid var(--color-hairline);
    background: var(--color-paper);
    overflow: hidden;
    cursor: pointer;
  }
  .wf-chrome {
    display: flex;
    align-items: center;
    gap: var(--gap-tight);
    padding: 8px 12px;
    border-bottom: 1px solid var(--color-hairline);
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-muted);
  }
  .wf-dots { display: flex; gap: 5px; }
  .wf-dots i {
    width: 8px; height: 8px; border-radius: 50%;
    border: 1px solid var(--color-hairline);
  }
  /* The address is one unbreakable string and was setting the minimum width of
     the whole frame. It truncates instead. */
  .wf-url {
    letter-spacing: 0.04em;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .wf-hint { margin-left: auto; opacity: 0; transition: opacity var(--duration-base) ease; white-space: nowrap; }
  .wf-frame:hover .wf-hint { opacity: 1; }

  .wf-viewport {
    position: relative;
    height: 68vh;
    min-height: 420px;
    overflow: hidden;
  }
  .wf-viewport img {
    position: absolute;
    top: 0; left: 0;
    width: 100%;
    height: auto;
    display: none;
    will-change: transform;
  }
  .wf-viewport img.is-active { display: block; }

  /* A 375px capture blown up to full frame width is a blurry wall of text.
     Show the phone at phone size, centred on the surface instead. */
  .wf-viewport.is-mobile {
    background: color-mix(in srgb, var(--color-ink) 6%, var(--color-paper));
  }
  /* A hard 375px is wider than the window it sits in on a 320px screen and
     dragged the whole frame past the edge. Phone width, or the room there is. */
  /* A hard 375px is wider than the window it sits in on a 320px screen and
     dragged the whole frame past the edge. Phone width, or the room there is.
     Centred with auto margins rather than a transform: the pinned
     scroll-through writes translateY to this element and would wipe out a
     translateX put here. */
  .wf-viewport.is-mobile img.is-active {
    width: min(375px, 100%);
    left: 0;
    right: 0;
    margin-inline: auto;
    box-shadow: 0 0 0 1px var(--color-hairline);
  }

  .wf-foot {
    display: flex;
    gap: var(--gap-block);
    margin-top: var(--gap-tight);
    font-family: var(--font-mono);
    font-size: var(--text-mono-caption);
    color: var(--color-muted);
  }
  .wf-live { margin-left: auto; color: var(--color-primary); }

  /* touch: pinning fights inertial scroll, so the frame just sits there */
  @media (max-width: 900px) {
    .wf-viewport { height: 46vh; min-height: 280px; }
    .wf-hint { opacity: 1; }
    /* on a phone the address and the hint cannot both fit; the hint is the
       one that tells you what to do, so the address goes */
    .wf-url { display: none; }
    /* the footer runs out of room for three items side by side */
    .wf-foot { flex-wrap: wrap; gap: var(--gap-tight) var(--gap-item); }
    .wf-live { margin-left: 0; }
    .wf-head { gap: var(--gap-item); }
  }

  @media (prefers-reduced-motion: reduce) {
    .wf-viewport img { transform: none !important; }
  }
</style>
