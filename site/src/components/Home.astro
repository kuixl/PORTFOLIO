---
/**
 * The home page, in whichever language it is handed. One component so the
 * English and Russian versions cannot drift apart in layout.
 */
import { home, type Lang } from '../data/home';
import works from '../../public/works/works.json';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = home[lang];
// Case pages exist in English only for now, so the Russian index links to them
// rather than to routes that would 404.
const p = '';

const monolithPages = ['index', 'archive', 'materials']
  .map((page) => works.monolith.find((s) => s.page === page && s.size === 'desktop'))
  .filter(Boolean)
  .map((s) => `/works/monolith/${s!.parts[0].file}`)
  .join(',');

const index = [
  { n: '01', title: 'nichive', kind: 'nichive', year: '2026', team: 'solo', href: `${p}/nichive` },
  { n: '02', title: 'Yakitoria', kind: 'yakitoria', year: '2025', team: 'solo', href: `${p}/yakitoria` },
  { n: '03', title: 'Monolith', kind: 'monolith', year: '2025', team: 'solo', full: monolithPages },
  { n: '04', title: 'BETA', kind: 'beta', year: '2026', team: 'team', href: `${p}/beta` },
];

const contacts = [
  ['asrieldreemur1213@gmail.com', 'mailto:asrieldreemur1213@gmail.com', '/logo/gmail.svg', 'Email'],
  ['t.me/kuixl', 'https://t.me/kuixl', '/logo/telegram.svg', 'Telegram'],
  ['github.com/kuixl', 'https://github.com/kuixl', '/logo/github.svg', 'GitHub'],
];
---
<header class="site-head">
  <span class="font-mono text-mono-nav">kuixl</span>
  <nav class="head-nav font-mono text-mono-nav">
    <a href="/" aria-current={lang === 'en' ? 'page' : undefined} class={lang === 'en' ? 'is-on' : ''}>EN</a>
    <span class="sep">/</span>
    <a href="/ru" aria-current={lang === 'ru' ? 'page' : undefined} class={lang === 'ru' ? 'is-on' : ''}>RU</a>
    <a href="#contact" class="head-contact">{lang === 'ru' ? 'КОНТАКТЫ' : 'CONTACT'}</a>
  </nav>
</header>

<main id="main">
  <section class="hero">
    <ul class="hero-tags">{t.tags.map((tag) => <li>{tag}</li>)}</ul>
    <h1 class="hero-title" set:html={t.title.replace('\n', '<br />')} />
    <p class="hero-lead">{t.lead}</p>
    <dl class="hero-meta">
      {t.meta.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
    </dl>
    <span class="hero-scroll font-mono">{t.scroll}</span>
  </section>

  <section class="works" id="works">
    <h2 class="sec-title" data-reveal>{t.works}</h2>
    <ol class="index" data-reveal data-reveal-children>
      {index.map((w) => {
        const Tag = w.href ? 'a' : 'button';
        return (
          <li class="index-row">
            <Tag class="index-link" href={w.href} type={w.href ? undefined : 'button'}
              data-fullview={w.full}
              data-fullview-label={w.full ? `${w.title} - full site` : undefined}>
              <span class="ix-n">{w.n}</span>
              <span class="ix-title">{w.title}</span>
              <span class="ix-meta">
                <span>{t.kinds[w.kind]}</span>
                <span>{w.year}</span>
                <span>{t.teams[w.team]}</span>
              </span>
              <span class="ix-go font-mono">{w.href ? t.caseLink : t.fullLink}</span>
            </Tag>
          </li>
        );
      })}
    </ol>
    <p class="index-note font-mono">{t.worksNote}</p>
  </section>

  <section class="profile" id="profile">
    <h2 class="sec-title" data-reveal>{t.profile}</h2>
    <div class="pf-grid" data-reveal data-reveal-children>
      <figure class="pf-portrait">
        <img src="/portrait.webp" alt="Konstantin Darovskiy" width="1200" height="1560" loading="lazy" />
        <figcaption class="font-mono">{t.portrait}</figcaption>
      </figure>
      <div class="pf-text">
        {t.profileText.map((para) => <p>{para}</p>)}
        <dl class="pf-facts">
          {t.facts.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
        </dl>
      </div>
    </div>
  </section>

  <section class="contact" id="contact">
    <div class="ct-head">
      <h2 class="ct-title" data-assemble>{t.contact}</h2>
      <div class="ct-status font-mono">{t.status.map((s) => <span>{s}</span>)}</div>
    </div>
    <ul class="ct-list">
      {contacts.map(([label, href, icon, name]) => (
        <li>
          <a href={href}>
            <img src={icon} alt="" width="22" height="22" loading="lazy" />
            <span class="ct-label">{label}</span>
            <span class="ct-kind font-mono">{name}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</main>

<footer class="site-foot font-mono">
  <span>kuixl</span>
  <span>{t.status[1]}</span>
</footer>

<style>
  .site-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 64px;
    padding-inline: 20px;
    border-bottom: 1px solid var(--color-hairline);
  }
  .head-nav { display: flex; align-items: center; gap: var(--gap-tight); }
  .head-nav a { color: var(--color-muted); }
  .head-nav a.is-on { color: var(--color-primary); }
  .head-nav .sep { color: var(--color-hairline); }
  .head-contact { margin-left: var(--gap-block); color: var(--color-primary) !important; }

  main { max-width: 1240px; margin-inline: auto; padding-inline: 20px; }

  .sec-title {
    font-family: var(--font-sans);
    font-weight: 900;
    font-size: clamp(40px, 9vw, 96px);
    line-height: 1;
    letter-spacing: -0.02em;
    margin-bottom: var(--gap-block);
  }

  .hero {
    position: relative;
    padding-block: var(--gap-block) var(--gap-section);
    min-height: 72vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .hero-tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: var(--text-mono-caption);
    letter-spacing: 0.1em;
    color: var(--color-muted);
  }
  .hero-tags li {
    display: grid;
    place-items: center;
    min-width: 132px;
    padding: 6px 12px;
    border: 1px solid var(--color-hairline);
  }
  .hero-meta {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
    margin-top: var(--gap-block);
    border-top: 1px solid var(--color-hairline);
  }
  .hero-meta > div {
    padding: var(--gap-item) var(--gap-block);
    border-right: 1px solid var(--color-hairline);
  }
  .hero-meta > div:first-child { padding-left: 0; }
  .hero-meta > div:last-child { border-right: 0; }
  .hero-meta dt {
    font-family: var(--font-mono);
    font-size: var(--text-mono-caption);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .hero-meta dd { margin-top: 4px; font-size: 15px; }
  .hero-title {
    margin-block: var(--gap-block);
    font-family: var(--font-sans);
    font-weight: 900;
    font-size: clamp(56px, 13vw, 180px);
    line-height: 0.9;
    letter-spacing: -0.03em;
  }
  .hero-lead { font-size: var(--text-body-lg); color: var(--color-muted); }
  .hero-scroll {
    position: absolute;
    bottom: var(--gap-item);
    left: 0;
    font-size: var(--text-mono-caption);
    color: var(--color-muted);
  }

  .works { padding-block: var(--gap-section); border-top: 1px solid var(--color-hairline); }
  .index { list-style: none; }
  .index-row + .index-row { border-top: 1px solid var(--color-hairline); }
  .index-link {
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-areas: 'n title' '. meta' '. go';
    gap: var(--gap-tight) var(--gap-block);
    width: 100%;
    padding-block: var(--gap-block);
    text-align: left;
    background: none;
    border: 0;
    cursor: pointer;
    font: inherit;
    color: inherit;
    transition: opacity 0.2s;
  }
  .index-link:hover { opacity: 0.55; }
  .ix-n {
    grid-area: n;
    font-family: var(--font-mono);
    font-size: clamp(24px, 5vw, 40px);
    color: var(--color-muted);
  }
  .ix-title {
    grid-area: title;
    font-family: var(--font-sans);
    font-weight: 900;
    font-size: clamp(32px, 7vw, 72px);
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .ix-meta {
    grid-area: meta;
    display: flex;
    flex-wrap: wrap;
    gap: var(--gap-item);
    font-family: var(--font-mono);
    font-size: var(--text-mono-caption);
    letter-spacing: 0.08em;
    color: var(--color-muted);
  }
  .ix-go { grid-area: go; font-size: var(--text-mono-caption); letter-spacing: 0.1em; }
  .index-note { margin-top: var(--gap-item); font-size: var(--text-mono-caption); color: var(--color-muted); }

  .profile { padding-block: var(--gap-section); border-top: 1px solid var(--color-hairline); }
  .pf-grid { display: grid; gap: var(--gap-block); }
  .pf-portrait img {
    width: 100%;
    max-width: 400px;
    height: auto;
    display: block;
    image-rendering: -webkit-optimize-contrast;
  }
  .pf-portrait figcaption {
    margin-top: var(--gap-tight);
    font-size: var(--text-mono-caption);
    letter-spacing: 0.1em;
    color: var(--color-muted);
  }
  .pf-text > * + * { margin-top: var(--gap-item); }
  .pf-text p { max-width: 62ch; }
  .pf-facts { margin-top: var(--gap-block); border-top: 1px solid var(--color-hairline); }
  .pf-facts div {
    display: grid;
    grid-template-columns: 1fr;
    gap: 5px;
    padding-block: var(--gap-item);
    border-bottom: 1px solid var(--color-hairline);
  }
  .pf-facts dt {
    font-family: var(--font-mono);
    font-size: var(--text-mono-caption);
    letter-spacing: 0.12em;
    color: var(--color-muted);
  }
  .pf-facts dd { font-size: 15px; line-height: 1.45; }

  .contact { padding-block: var(--gap-section); border-top: 1px solid var(--color-hairline); }
  .ct-head { display: flex; flex-wrap: wrap; align-items: baseline; gap: var(--gap-block); }
  .ct-title {
    font-family: var(--font-sans);
    font-weight: 900;
    font-size: clamp(40px, 9vw, 96px);
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .ct-status {
    display: flex;
    flex-direction: column;
    font-size: var(--text-mono-caption);
    letter-spacing: 0.1em;
    color: var(--color-muted);
  }
  .ct-list { list-style: none; margin-top: var(--gap-block); display: grid; border-top: 1px solid var(--color-hairline); }
  .ct-list a {
    display: grid;
    grid-template-columns: 22px minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--gap-item);
    padding-block: var(--gap-item);
    border-bottom: 1px solid var(--color-hairline);
    font-size: clamp(18px, 2.4vw, 22px);
  }
  .ct-list img { display: block; }
  .ct-kind {
    font-size: var(--text-mono-caption);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .ct-list a:hover .ct-label { text-decoration: underline; text-underline-offset: 4px; }

  .site-foot {
    display: flex;
    justify-content: space-between;
    padding: var(--gap-item) 20px;
    border-top: 1px solid var(--color-hairline);
    font-size: var(--text-mono-caption);
    letter-spacing: 0.1em;
    color: var(--color-muted);
  }

  @media (min-width: 901px) {
    main, .site-head, .site-foot { padding-inline: var(--spacing-080); }
    .index-link {
      grid-template-columns: 90px minmax(0, 1fr) auto auto;
      grid-template-areas: 'n title meta go';
      align-items: baseline;
      gap: var(--gap-block);
    }
    .ix-meta { justify-content: flex-end; }
    .pf-grid { grid-template-columns: 340px minmax(0, 1fr); gap: var(--gap-block); }
    .pf-facts div { grid-template-columns: 170px minmax(0, 1fr); gap: var(--gap-block); align-items: baseline; }
  }
</style>
